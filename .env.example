# Supabase (חובה - צור פרויקט בחינם ב-https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Gmail OAuth (לשליחת קבלות מהמייל שלך - אופציונלי)
# הנחיות: https://console.cloud.google.com -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Resend (גיבוי לשליחת מייל - אופציונלי)
# הירשם ב-https://resend.com (חינמי 3000 מיילים/חודש)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# פרטי האפליקציה
NEXT_PUBLIC_APP_URL=http://localhost:3000
